<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Bump this with every release tag. The Resolve version step fails the build
      when the two disagree, which is why this service was the only one whose
      reported version was ever right.

      The release workflow also passes -p:Version from the tag, so the built
      binary takes its version from there rather than from here. Leave
      AssemblyVersion, FileVersion and InformationalVersion unset: the SDK
      derives all three from Version, and setting them here would pin them past
      anything the tag says — a command-line Version overrides this property but
      not siblings assigned next to it.
    -->
    <Version>1.4.1</Version>
    <Product>Scale Reader Service</Product>
    <Description>Reads weight data from industrial scales via IP (SMA, Mettler Toledo) and posts to web applications via SignalR.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="scale-models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.*" />
    <PackageReference Include="System.Device.Gpio" Version="3.2.0" />
  </ItemGroup>

</Project>
